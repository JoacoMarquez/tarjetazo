# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backoffice (/admin): ids de usuario de Supabase (Authentication > Users),
# separados por coma. Si está, manda y ADMIN_EMAILS no se usa.
ADMIN_USER_IDS=
# Alternativa por email confirmado, separados por coma. Vacíos los dos = nadie entra.
ADMIN_EMAILS=

# Claude (normalizacion de beneficios)
ANTHROPIC_API_KEY=

# Captcha de Cloudflare Turnstile para login, alta y recuperación (opcional).
# La secret key va en Supabase > Authentication > Attack Protection, no acá.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analítica anónima con PostHog (opcional): la clave pública del proyecto
# (phc_…), región EU. Los pedidos van por el proxy propio /ingest, así que no
# hace falta un host. Sin clave no se mide nada.
NEXT_PUBLIC_POSTHOG_KEY=
