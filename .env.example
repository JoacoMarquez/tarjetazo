# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backoffice (/admin): ids de usuario de Supabase (Authentication > Users),
# separados por coma. Si está, manda y ADMIN_EMAILS no se usa.
ADMIN_USER_IDS=
# Alternativa por email confirmado, separados por coma. Vacíos los dos = nadie entra.
ADMIN_EMAILS=

# Claude (normalizacion de beneficios)
ANTHROPIC_API_KEY=

# Analytics (opcional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
