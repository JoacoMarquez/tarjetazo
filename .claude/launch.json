{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tarjetazo-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@tarjetazo/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "tarjetazo-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@tarjetazo/web",
        "start",
        "-p",
        "3210"
      ],
      "port": 3210
    }
  ]
}